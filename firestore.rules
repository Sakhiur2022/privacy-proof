rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidEmail(email) {
      return email is string 
        && email.size() >= 3 
        && email.size() <= 254;
    }

    // 2. Validation blueprint for incoming lead documents
    function isValidLead(data) {
      return data.keys().hasAll(['email', 'source', 'createdAt'])
        && data.keys().hasOnly(['email', 'source', 'tier', 'createdAt'])
        && isValidEmail(data.email)
        && data.source is string && data.source.size() <= 100
        && (!('tier' in data) || data.tier == null || (data.tier is string && data.tier.size() <= 100))
        && (data.createdAt is timestamp || data.createdAt == request.time || data.createdAt is string);
    }

    // 3. Collection rules for leads
    match /leads/{leadId} {
      // Anyone may create a lead (with validated email and timestamp)
      allow create: if isValidLead(request.resource.data);

      // Public visitors can NEVER read, update, or delete any leads
      allow read, update, delete: if false;
    }
  }
}
